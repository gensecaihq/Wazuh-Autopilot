{
  // =============================================================================
  // WAZUH AUTOPILOT — NemoClaw Configuration (NVIDIA Stack ONLY)
  // =============================================================================
  // JSON5 format: comments and trailing commas are allowed.
  //
  // This profile runs the OpenClaw agents INSIDE an NVIDIA NemoClaw sandbox
  // (OpenShell runtime). NemoClaw deployments MUST stay on the NVIDIA stack:
  //
  //   - Models:    NVIDIA Nemotron 3 family ONLY (Ultra / Super / Nano)
  //   - Inference: build.nvidia.com hosted endpoints, local NIM microservices
  //                (TensorRT-LLM), or Ollama serving Nemotron models
  //   - Runtime:   OpenShell sandbox with out-of-process policy enforcement
  //   - Hardware:  DGX Spark, DGX Station, RTX PRO workstations, GeForce RTX,
  //                or WSL2 hosts (GPU optional for hosted inference)
  //
  // Do NOT add Anthropic/OpenAI/Google/etc. providers or keys to this file.
  // If you want mixed cloud providers, use openclaw/openclaw.json (plain
  // OpenClaw) instead — NemoClaw's value is the governed, single-vendor path.
  //
  // Install NemoClaw (creates the OpenShell sandbox with a fresh OpenClaw):
  //
  //   curl -fsSL https://www.nvidia.com/nemoclaw.sh | \
  //     NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1 \
  //     NEMOCLAW_AGENT=openclaw \
  //     NEMOCLAW_PROVIDER=build \
  //     NVIDIA_INFERENCE_API_KEY=nvapi-... \
  //     NEMOCLAW_SANDBOX_NAME=wazuh-autopilot \
  //     bash
  //
  // Then apply this config inside the sandbox (see nemoclaw/README.md):
  //
  //   nemoclaw wazuh-autopilot connect
  //   # inside sandbox:
  //   cp openclaw-nemoclaw.json ~/.openclaw/openclaw.json
  //   cp -r openclaw/agents ~/.openclaw/wazuh-autopilot/
  //   openclaw models scan       # REQUIRED — populates toolUse capability for
  //                              # openai-completions providers; without it,
  //                              # tool calls are emitted as plain text.
  //   openclaw doctor --fix
  //
  // Local NIM (self-hosted, TensorRT-LLM optimized) example:
  //
  //   docker run --gpus all -p 8000:8000 \
  //     -e NGC_API_KEY=$NGC_API_KEY \
  //     nvcr.io/nim/nvidia/nemotron-3-nano-30b-a3b:latest
  //   # Verify served model id: curl http://127.0.0.1:8000/v1/models
  //
  // Ollama alternative (experimental in NemoClaw):
  //
  //   ollama pull nemotron-3-nano:30b
  //   curl -fsSL https://www.nvidia.com/nemoclaw.sh | \
  //     NEMOCLAW_NON_INTERACTIVE=1 NEMOCLAW_PROVIDER=ollama \
  //     NEMOCLAW_MODEL=nemotron-3-nano:30b bash
  // =============================================================================

  // ---------------------------------------------------------------------------
  // GATEWAY
  // ---------------------------------------------------------------------------
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_TOKEN}"
    }
  },

  // ---------------------------------------------------------------------------
  // LOGGING
  // ---------------------------------------------------------------------------
  "logging": {
    "redactSensitive": "tools"
  },

  // ---------------------------------------------------------------------------
  // MODEL PROVIDERS — NVIDIA STACK ONLY
  // ---------------------------------------------------------------------------
  // "nvidia"    — build.nvidia.com hosted endpoints (OpenAI-compatible).
  //               Model refs are "nvidia/" + full catalog id, so the doubled
  //               "nvidia/nvidia/..." below is intentional.
  // "nim-local" — self-hosted NIM microservice on this host (TensorRT-LLM).
  //               The model "id" MUST match the NIM's served model name —
  //               verify with: curl http://127.0.0.1:8000/v1/models
  // ---------------------------------------------------------------------------
  "models": {
    "providers": {
      "nvidia": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "api": "openai-completions",
        "apiKey": "${NVIDIA_API_KEY}",
        "models": [
          // ---------------------------------------------------------------
          // Nemotron 3 Super 120B (A12B MoE) — RECOMMENDED default
          // Strong agentic/tool calling, 1M context, fast + cost-efficient
          // ---------------------------------------------------------------
          {
            "id": "nvidia/nemotron-3-super-120b-a12b",
            "name": "Nemotron 3 Super 120B (build.nvidia.com)",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 1000000,
            "maxTokens": 8192
          },

          // ---------------------------------------------------------------
          // Nemotron 3 Ultra 550B (A55B MoE) — highest capability, 1M context
          // Use for complex investigation / response planning fallback
          // ---------------------------------------------------------------
          {
            "id": "nvidia/nemotron-3-ultra-550b-a55b",
            "name": "Nemotron 3 Ultra 550B (build.nvidia.com)",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 1000000,
            "maxTokens": 8192
          },

          // ---------------------------------------------------------------
          // Nemotron 3 Nano 30B (A3B MoE) — cheap/fast for heartbeats, reports
          // Verify exact catalog id with:
          //   curl https://integrate.api.nvidia.com/v1/models \
          //     -H "Authorization: Bearer $NVIDIA_API_KEY" | grep nemotron
          // ---------------------------------------------------------------
          {
            "id": "nvidia/nemotron-3-nano-30b-a3b",
            "name": "Nemotron 3 Nano 30B (build.nvidia.com)",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      },

      "nim-local": {
        "baseUrl": "http://127.0.0.1:8000/v1",
        "api": "openai-completions",
        "apiKey": "${NIM_API_KEY}",
        "models": [
          // ---------------------------------------------------------------
          // Local NIM — Nemotron 3 Nano 30B (TensorRT-LLM optimized)
          // Runs on a single 24GB+ GPU (RTX PRO / GeForce RTX / DGX Spark).
          // Fully offline path: pair with OpenShell "Restricted" policy tier.
          // ---------------------------------------------------------------
          {
            "id": "nvidia/nemotron-3-nano-30b-a3b",
            "name": "Nemotron 3 Nano 30B (local NIM)",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      }
    }
  },

  // ---------------------------------------------------------------------------
  // AGENT CONFIGURATION
  // ---------------------------------------------------------------------------
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/wazuh-autopilot/workspace",

      // Hosted Nemotron primary; local NIM as offline fallback.
      // For fully air-gapped DGX/RTX deployments, swap primary to
      // "nim-local/nvidia/nemotron-3-nano-30b-a3b" and remove the hosted refs.
      "model": {
        "primary": "nvidia/nvidia/nemotron-3-super-120b-a12b",
        "fallbacks": [
          "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
          "nim-local/nvidia/nemotron-3-nano-30b-a3b"
        ]
      },

      "models": {
        "nvidia/nvidia/nemotron-3-super-120b-a12b": { "alias": "super" },
        "nvidia/nvidia/nemotron-3-ultra-550b-a55b": { "alias": "ultra" },
        "nvidia/nvidia/nemotron-3-nano-30b-a3b": { "alias": "nano" },
        "nim-local/nvidia/nemotron-3-nano-30b-a3b": { "alias": "nim" }
      },

      // OpenShell already sandboxes the whole gateway (out-of-process policy
      // enforcement), but keep OpenClaw's inner sandbox too — defense in depth.
      "sandbox": {
        "mode": "all",
        "scope": "session",
        // Issue #18 fix: web_fetch is not in the sandbox default allow list.
        "tools": {
          "alsoAllow": ["web_fetch"]
        }
      },

      // Heartbeat on Nano. COST NOTE (issue #33): heartbeats run inference on a
      // timer even at zero alerts — on a local DGX/RTX GPU that keeps the card
      // busy and the node never idles. OpenClaw rule: only agents that declare a
      // `heartbeat` block run heartbeats, so here only triage + correlation do
      // (this defaults block is just the merge template). Set both per-agent
      // heartbeats to "0m" for fully event-driven (recommended for local GPU).
      // See docs/HEARTBEATS_AND_COST.md.
      "heartbeat": {
        "every": "30m",
        "model": "nvidia/nvidia/nemotron-3-nano-30b-a3b"
      },

      // Local embeddings — no non-NVIDIA cloud dependency for memory search
      "memorySearch": {
        "sources": ["memory", "sessions"],
        "provider": "local",
        "model": "hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M.gguf"
      },

      "maxConcurrent": 3,
      "timeoutSeconds": 900
    },

    "list": [
      // =====================================================================
      // TRIAGE AGENT — First responder for alert analysis
      // =====================================================================
      {
        "id": "wazuh-triage",
        "default": true,
        "workspace": "~/.openclaw/wazuh-autopilot/agents/triage",
        "agentDir": "~/.openclaw/wazuh-autopilot/agents/triage",
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "edit", "web_fetch", "sessions_list", "sessions_history"],
          "deny": ["write", "exec", "delete", "browser"]
        },
        "heartbeat": { "every": "30m" }  // issue #33: was 10m; "0m" = event-driven (docs/HEARTBEATS_AND_COST.md)
      },

      // =====================================================================
      // CORRELATION AGENT — Pattern detection and timeline building
      // =====================================================================
      {
        "id": "wazuh-correlation",
        "workspace": "~/.openclaw/wazuh-autopilot/agents/correlation",
        "agentDir": "~/.openclaw/wazuh-autopilot/agents/correlation",
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "edit", "web_fetch", "sessions_list", "sessions_history"],
          "deny": ["write", "exec", "delete", "browser"]
        },
        "heartbeat": { "every": "30m" }  // issue #33: was 5m; "0m" = event-driven (docs/HEARTBEATS_AND_COST.md)
      },

      // =====================================================================
      // INVESTIGATION AGENT — Deep analysis and evidence gathering
      // =====================================================================
      {
        "id": "wazuh-investigation",
        "workspace": "~/.openclaw/wazuh-autopilot/agents/investigation",
        "agentDir": "~/.openclaw/wazuh-autopilot/agents/investigation",
        "model": {
          "primary": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
          "fallbacks": ["nvidia/nvidia/nemotron-3-super-120b-a12b"]
        },
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "edit", "web_fetch", "sessions_list", "sessions_history"],
          "deny": ["write", "exec", "delete", "browser"]
        }
      },

      // =====================================================================
      // RESPONSE PLANNER — Generate response plans (no execution)
      // =====================================================================
      {
        "id": "wazuh-response-planner",
        "workspace": "~/.openclaw/wazuh-autopilot/agents/response-planner",
        "agentDir": "~/.openclaw/wazuh-autopilot/agents/response-planner",
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "write", "web_fetch", "sessions_list", "sessions_history", "sessions_send"],
          "deny": ["exec", "delete", "browser"]
        }
      },

      // =====================================================================
      // POLICY GUARD — Constitutional enforcement
      // =====================================================================
      {
        "id": "wazuh-policy-guard",
        "workspace": "~/.openclaw/wazuh-autopilot/agents/policy-guard",
        "agentDir": "~/.openclaw/wazuh-autopilot/agents/policy-guard",
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "edit", "web_fetch", "sessions_list", "sessions_history", "sessions_send"],
          "deny": ["write", "exec", "delete", "browser"]
        }
      },

      // =====================================================================
      // RESPONDER — Action execution (requires elevated permissions)
      // =====================================================================
      {
        "id": "wazuh-responder",
        "workspace": "~/.openclaw/wazuh-autopilot/agents/responder",
        "agentDir": "~/.openclaw/wazuh-autopilot/agents/responder",
        "model": {
          "primary": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "fallbacks": ["nvidia/nvidia/nemotron-3-ultra-550b-a55b"]
        },
        "tools": {
          "profile": "coding",
          "alsoAllow": ["read", "write", "web_fetch", "sessions_list", "sessions_history", "sessions_send"],
          "deny": ["browser", "delete"],
          "elevated": { "enabled": true }
        },
        "sandbox": {
          "mode": "all",
          "scope": "agent"
        }
      },

      // =====================================================================
      // REPORTING — Metrics, KPIs, and digest generation
      // =====================================================================
      {
        "id": "wazuh-reporting",
        "workspace": "~/.openclaw/wazuh-autopilot/agents/reporting",
        "agentDir": "~/.openclaw/wazuh-autopilot/agents/reporting",
        "model": "nvidia/nvidia/nemotron-3-nano-30b-a3b",
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "write", "web_fetch", "sessions_list", "sessions_history"],
          "deny": ["exec", "delete", "browser"]
        }
      }
    ]
  },

  // ---------------------------------------------------------------------------
  // GLOBAL TOOL POLICY
  // ---------------------------------------------------------------------------
  "tools": {
    "profile": "minimal",
    "alsoAllow": ["read", "web_fetch", "sessions_list", "sessions_history"],
    "deny": ["browser", "canvas"],
    "web": {
      "search": { "enabled": false },
      "fetch": { "enabled": true }
    }
  },

  // ---------------------------------------------------------------------------
  // CRON
  // ---------------------------------------------------------------------------
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 3
  },

  // ---------------------------------------------------------------------------
  // HOOKS — Webhook endpoints for Wazuh alert routing
  // ---------------------------------------------------------------------------
  // NOTE: the runtime service must be reachable from inside the OpenShell
  // sandbox. Add MCP_URL and AUTOPILOT_RUNTIME_URL to the sandbox's network
  // policy allowlist (see nemoclaw/README.md — Policy Tiers).
  "hooks": {
    "enabled": true,
    "path": "/webhook",
    "token": "${OPENCLAW_WEBHOOK_TOKEN}",
    "mappings": [
      {
        "match": { "path": "wazuh-alert" },
        "action": "agent",
        "agentId": "wazuh-triage",
        "messageTemplate": "{{message}}",
        "name": "Wazuh Alert Triage",
        "allowUnsafeExternalContent": true
      },
      {
        "match": { "path": "case-created" },
        "action": "agent",
        "agentId": "wazuh-correlation",
        "messageTemplate": "{{message}}",
        "name": "Wazuh Correlation",
        "allowUnsafeExternalContent": true
      },
      {
        "match": { "path": "investigation-request" },
        "action": "agent",
        "agentId": "wazuh-investigation",
        "messageTemplate": "{{message}}",
        "name": "Wazuh Investigation",
        "allowUnsafeExternalContent": true
      },
      {
        "match": { "path": "plan-request" },
        "action": "agent",
        "agentId": "wazuh-response-planner",
        "messageTemplate": "{{message}}",
        "name": "Wazuh Response Planning",
        "allowUnsafeExternalContent": true
      },
      {
        "match": { "path": "policy-check" },
        "action": "agent",
        "agentId": "wazuh-policy-guard",
        "messageTemplate": "{{message}}",
        "name": "Wazuh Policy Check",
        "allowUnsafeExternalContent": true
      },
      {
        "match": { "path": "execute-action" },
        "action": "agent",
        "agentId": "wazuh-responder",
        "messageTemplate": "{{message}}",
        "name": "Wazuh Action Execution",
        "allowUnsafeExternalContent": true
      }
    ]
  },

  // ---------------------------------------------------------------------------
  // ENVIRONMENT VARIABLES — NVIDIA stack + Autopilot integration ONLY
  // ---------------------------------------------------------------------------
  "env": {
    "NVIDIA_API_KEY": "${NVIDIA_API_KEY}",
    "NIM_API_KEY": "${NIM_API_KEY}",
    "OPENCLAW_TOKEN": "${OPENCLAW_TOKEN}",
    "OPENCLAW_WEBHOOK_TOKEN": "${OPENCLAW_WEBHOOK_TOKEN}",
    "MCP_URL": "${MCP_URL}",
    "AUTOPILOT_MCP_AUTH": "${AUTOPILOT_MCP_AUTH}",
    "OPENCLAW_GATEWAY_URL": "${OPENCLAW_GATEWAY_URL}",
    "AUTOPILOT_RUNTIME_URL": "${AUTOPILOT_RUNTIME_URL}"
  }
}
