# =============================================================================
# WAZUH AUTOPILOT — Hermes Agent secrets (~/.hermes/.env)
# =============================================================================
# Secrets live here; settings live in config.yaml. `hermes config set KEY VAL`
# routes API keys here automatically.

# --- Primary model provider (pick ONE path) ----------------------------------
# OpenRouter (default in config.yaml.example)
OPENROUTER_API_KEY=

# NVIDIA stack (REQUIRED if running under NemoClaw — see nemoclaw/README.md)
# Key from https://build.nvidia.com (starts with "nvapi-")
NVIDIA_API_KEY=

# Nous Portal alternative: run `hermes setup --portal` (OAuth, no key here)

# --- Wazuh Autopilot integration ---------------------------------------------
# HTTP MCP server (48 Wazuh tools) — bridged via mcp-remote in config.yaml
MCP_URL=https://your-mcp-server:3000
AUTOPILOT_MCP_AUTH=your-mcp-token

# Runtime service (cases, plans, two-tier approval API)
AUTOPILOT_RUNTIME_URL=http://127.0.0.1:8787
AUTOPILOT_SERVICE_TOKEN=your-service-token
