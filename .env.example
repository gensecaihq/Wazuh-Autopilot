# =============================================================================
# Wazuh Autopilot — environment (copy to .env)
# Most settings are managed in the UI (Settings) after first boot; these seed them.
# =============================================================================

# --- Platform ---------------------------------------------------------------
POSTGRES_PASSWORD=                 # required: openssl rand -base64 24
AUTOPILOT_SECRET_KEY=              # required in production: openssl rand -base64 48
AUTOPILOT_ADMIN_EMAIL=admin@example.com
AUTOPILOT_ADMIN_PASSWORD=          # first admin; leave empty to use the setup wizard
AUTOPILOT_ORG_NAME=Acme Corp
AUTOPILOT_PORT=8480
AUTOPILOT_BIND=127.0.0.1           # put a TLS reverse proxy in front for remote access
AUTOPILOT_DEMO_MODE=false

# --- Wazuh MCP Server (gensecaihq/Wazuh-MCP-Server v4.3.0) ------------------
# Base URL; /mcp is appended. The API key is exchanged for a JWT at /auth/token.
# Active response needs MCP_API_KEY_SCOPES="wazuh:read wazuh:write" on the MCP server.
WAZUH_MCP_URL=https://wazuh-mcp.internal:3000
WAZUH_MCP_API_KEY=

# --- Model provider: bedrock | anthropic | openai | vllm | litellm | ollama | demo
MODEL_PROVIDER=bedrock
MODEL_ID=global.anthropic.claude-sonnet-5
MODEL_BASE_URL=                    # vllm: http://vllm:8000/v1  ollama: http://ollama:11434  litellm: http://litellm:4000
MODEL_API_KEY=
AWS_REGION=us-east-1
# Bedrock on AWS compute uses the task/instance IAM role; locally set AWS_PROFILE or keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ANTHROPIC_API_KEY=               # used by the litellm profile config
# HUGGING_FACE_HUB_TOKEN=          # vllm profile
# VLLM_MODEL=Qwen/Qwen3-32B

# --- Ingestion ----------------------------------------------------------------
AUTOPILOT_INGEST_KEY=              # header X-Autopilot-Ingest-Key for POST /api/v1/ingest/wazuh
